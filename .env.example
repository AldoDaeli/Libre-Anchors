# Salin menjadi .env untuk development lokal. JANGAN di-commit (sudah ada di .gitignore).
# Di Vercel: isi semua nilai ini di Project > Settings > Environment Variables.

# development | production
APP_ENV=development

# WAJIB di production: string acak panjang (>= 32 karakter). Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Database ---
# Kosongkan saat development = pakai SQLite lokal otomatis (instance/tuxpedia.db).
# Production (Supabase): Project Settings > Database > Connection string > "Transaction pooler" (port 6543):
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# --- Email OTP lewat Gmail ---
# smtp = kirim sungguhan | console = cetak OTP di terminal (khusus development)
MAIL_BACKEND=console
GMAIL_USER=emailkamu@gmail.com
# BUKAN sandi Gmail biasa. Buat "App Password" 16 karakter (lihat README).
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Tuxpedia

# Login = sandi + OTP email (true) atau cukup sandi setelah akun terverifikasi (false)
LOGIN_OTP=true

# --- Production (Vercel) ---
# APP_ENV=production
# MAIL_BACKEND=smtp
# COOKIE_SECURE=true
# TRUSTED_PROXIES=1
# ALLOWED_HOSTS=tuxpedia.vercel.app,www.domainmu.com
